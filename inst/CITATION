# Version and year are taken from DESCRIPTION so there is one source of truth;
# bumping Version/Date is enough to keep citation() current.
#
# DOI. Zenodo mints two. 10.5281/zenodo.22231870 is the concept DOI, which
# always resolves to the newest archived version and is what the README badge
# points at; it never changes. 10.5281/zenodo.22231871 is the version DOI for
# 0.6.0 specifically, and it is the one used below, because this entry cites a
# stated package version rather than the package in general.
#
# At the next release, update `doi` and `textVersion` to that release's version
# DOI, which Zenodo mints when the GitHub release is published. Leave the README
# badge alone: the concept DOI covers every version.
year <- if (!is.null(meta$Date)) {
  format(as.Date(meta$Date), "%Y")
} else {
  format(Sys.Date(), "%Y")
}
version <- meta$Version

citHeader(
  "To cite skellambrms in publications, cite the package itself and, ",
  "because every family here is a brms custom family, brms as well ",
  "(citation(\"brms\")). If you use a specific family, please also cite the ",
  "distribution it implements -- see the References section of the package ",
  "README for Skellam (1946) and Karlis & Ntzoufras (2006)."
)

bibentry(
  bibtype  = "Manual",
  title    = "{skellambrms}: Skellam and Discrete-Difference {brms} Custom Families for Count Differences",
  author   = person(
    "Adam N. H.", "Smith",
    comment = c(ORCID = "0000-0003-0059-6206")
  ),
  year     = year,
  note     = paste("R package version", version),
  url      = "https://github.com/anhsmith/skellambrms",
  doi      = "10.5281/zenodo.22231871",
  header   = "Package citation:",
  textVersion = paste0(
    "Smith, A. N. H. (", year, "). skellambrms: Skellam and ",
    "Discrete-Difference brms Custom Families for Count Differences. ",
    "R package version ", version, ". ",
    "https://doi.org/10.5281/zenodo.22231871"
  )
)
